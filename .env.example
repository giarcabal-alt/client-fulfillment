# Used to build absolute redirect URLs for auth emails (invite, recovery) —
# Server Actions have no request URL to derive this from. Set to the real
# deployed origin in production (e.g. https://app.upscalesupport.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client bundle. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — used for server-side suggested-message generation.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — only needed if ANTHROPIC_API_KEY above is an *unscoped*
# (org-level) key rather than a workspace-scoped one. Anthropic's API
# rejects unscoped keys with a 400 unless every request also carries this
# header. Find it in the Anthropic Console under the workspace you want
# this app's usage billed/tracked under. Leave unset entirely if your key
# is already workspace-scoped.
ANTHROPIC_WORKSPACE_ID=your-anthropic-workspace-id
